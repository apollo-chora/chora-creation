# Local configuration for chora-creation.
# Copy to .env and fill in values. Never commit .env or secrets.

CHORA_ENV=local
PORT=8080
CHORA_GRPC_PORT=9090

# Database (PostgreSQL). CHORA_DB_DSN is the runtime DSN (app_rw role).
# CHORA_OUTBOX_DSN defaults to the same database when omitted.
POSTGRES_DB=chora_creation
POSTGRES_USER=chora
POSTGRES_PASSWORD=chora
POSTGRES_PORT=5432
CHORA_DB_DSN=postgres://chora:chora@postgres:5432/chora_creation?sslmode=disable
CHORA_OUTBOX_DSN=postgres://chora:chora@postgres:5432/chora_creation?sslmode=disable
CHORA_OUTBOX_WORKER_ID=chora-creation-local

# Event bus — NATS JetStream. Unset disables the bus (in-memory fallback).
NATS_URL=nats://nats:4222
NATS_PORT=4222
NATS_MONITOR_PORT=8222
CHORA_SOURCE_PROJECT=chora-local
CHORA_SOURCE_SERVICE=chora-creation

# Tracing — OTLP/gRPC endpoint (the OTel Collector). Unset falls back to stdout.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# S3-compatible object storage (MinIO / S3) for blob + atom-media uploads.
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
ATOM_MEDIA_BUCKET=chora-atom-media
GCS_BUCKET_BATCH_UPLOADS=chora-creation-batch-uploads

# Optional service mesh / cross-service gRPC targets.
SVC_IDENTITY_GRPC_URL=
SVC_SHARING_GRPC_URL=
SVC_MODEL_BROKER_ROUTER_URL=
CHORA_MODEL_GATEWAY_GRPC_URL=
